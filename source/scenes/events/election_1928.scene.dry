title: Senate Elections
new-page: true
tags: event
priority: -1
view-if: (year = next_election_year and month >= next_election_month) or (year > next_election_year)
on-departure: month_actions += 1; in_election = 0; next_election_year = next_election_year + 4; n_elections += 1; next_election_time = time + 48; papen_chancellor_timer = 4;
set-jump: post_election_1928

# TODO: should there be an image?

# the low priority means that this event is only seen after all other events are resolved for the month.

= Elections, [+ month : month +] [+ year +]

Senate elections are to be held now.

- @election_algorithm: May we do our best...

@post_election_1928
on-arrival: {!
// set old results
// election threshold constitutional reform
// banning parties
var new_party_sum = 0;
for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
    if (Q.constitutional_reform > 0) {
        if (Q[party + '_votes'] < Q.electoral_threshold || (Q.electoral_threshold > 1 && party == 'other') || Q[party + '_banned']) {
            Q[party + '_r'] = 0;
        } else {
            Q[party + '_r'] = Q[party + '_votes'];
        }
        new_party_sum += Q[party + '_r'];
    } else {
        Q[party + '_r'] = Q[party + '_votes'];
    }
    // if we use decimals, then we might want to truncate the numbers
    if (Q.use_decimals) {
        Q[party + '_r_disp'] = Q[party+'_r'].toFixed(1);
    }  else {
            Q[party + '_r_disp'] = Q[party+'_r'];
    }
    Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
    var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
    Q['str_change_' + party] = sign + Q['change_' + party + '_r'];//.toFixed(1);
}
// calculate new party sum if electoral reform
if (Q.electoral_threshold && Q.electoral_threshold > 0) {
    for (var party of Q.parties) {
        if (Q[party + '_r'] > 0) {
            if (Q.use_decimals) {
                Q[party + '_r'] = Math.round(Q[party + '_r']*1000/new_party_sum)/10;
            } else {
                Q[party + '_r'] = Math.round(Q[party + '_r']*100/new_party_sum);
            }
        }
        if (Q.use_decimals) {
            Q[party + '_r_disp'] = Q[party+'_r'].toFixed(1);
        } else {
            Q[party + '_r_disp'] = Q[party+'_r'];
        }
        Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
        var sign = Q['change_' + party + '_r'] > 0 ? '+'  : '';
        Q['str_change_' + party] = sign + Q['change_' + party + '_r'];//.toFixed(1);
    }
}

// get change arrows and signs


// The largest party can only be the KCP or the UP.
Q.largest_party = 'KCP';
if (Q.up_r >= Q.hp_r && Q.kcp_r >= Q.vnpf_r) {
    Q.largest_party = 'UP';
}

if (Q.hp_r >= Q.kcp_r && Q.vnpf_r >= Q.up_r) {
    Q.largest_party = 'HP';
}

// coalitions
Q.left_coalition = Q.kcp_r + Q.up_r;
Q.populist_coalition = Q.up_r + Q.vnpf_r;
Q.anti_coalition = Q.hp_r + Q.vnpf_r + Q.up_r;
Q.national_coalition = Q.vnpf_r + Q.hp_r;
Q.regional_coalition = Q.vnpf_r + Q.kcp_r

Q.leverage = Q.kcp_r;

Q.foreign_minister_party = 'I';
Q.interior_minister_party = 'I';
Q.justice_minister_party = 'I';
Q.labor_minister_party = 'I';
Q.reichswehr_minister_party = 'I';
Q.economic_minister_party = 'I';
Q.finance_minister_party = 'I';
Q.agriculture_minister_party = 'I';



var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: nazi_urgency = 1 if (nazi_urgency == 0 and nsdap_r >= 15)
on-display: {!
data =([
    {
        "id": "kcp",
        "legend": "KCP",
        "name": "KCP",
        "seats": Math.round(Q.kcp_r*5),
    },
    {
        "id": "up",
        "legend": "UP",
        "name": "UP",
        "seats": Math.round(Q.up_r*5),
    },
    {
        "id": "hp",
        "legend": "HP",
        "name": "HP",
        "seats": Math.round(Q.hp_r*5),
    },
    {
        "id": "vnpf",
        "legend": "VNPF",
        "name": "VNPF",
        "seats": Math.round(Q.vnpf_r*5),
    },
]);

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

= Election results

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!} 
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#2600e3; outline: 2px; outline-style: solid;'> </div> !} **KCP:** {!</td><td>!} **[+ kcp_r +]%** {!</td><td>!} **[+ str_change_kcp +]** {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#d60404'> </div> !} UP: {!</td><td>!} [+ up_r +]% {!</td><td>!} [+ str_change_up +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ca07e8'> </div> !} VNPF : {!</td><td>!} [+ vnpf_r +]% {!</td><td>!} [+ str_change_vnpf +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ffbd08'> </div> !} HP : {!</td><td>!} [+ hp_r +]% {!</td><td>!} [+ str_change_hp +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Constitutionalist-Regional Coalition (VNPF + KCP): [+ regional_coalition +]%

Left-Constitutionalist (KCP + UP): [+ left_coalition +]%

Populist-Left Coalition (VNPF + UP): [+ populist_coalition +]%

Anti-Constitutionalist Coalition (VNPF + UP + HP): [+ anti_coalition +]%

National Coalition (VNPF + HP): [+ national_coalition +]%

There are some potential coalition arrangements.

@coalition_menu

- @kcp_majority
- @left_coalition
- @anti_coalition
- @populist_coalition
- @national_coalition
- @regional_coalition

@kcp_majority
title: KCP majority alone
subtitle: KCP: [+ kcp_r +]%
view-if: kcp_r >= 50
on-arrival: leverage +=5 ;chancellor = "Empty"; chancellor_party = "KCP"; kcp_in_government = 1; in_kcp_majority = 1; pro_republic += 5; foreign_minister_party = "KCP"; foreign_minister = "Anovium"; national_defence_minister_party = "KCP"; national_defence_minister = "Duumvirate"; labor_minister_party = "KCP"; labor_minister = "Pengu"; finance_minister_party = "KCP"; finance_minister = "Triumvirate"; infrastructure_minister_party = "KCP"; culture_minister = "Primus" ; culture_minister_party = "KCP" ; infrastructure_minister = "Pengu"; reichswehr_loyalty -= 0.05; 

The KCP assumes its place as the party of natural governance. This place has mostly been earned by the momentum hidden behind the party as the party which helped found the republic.

Who should be primus?

- @annastasia_majority_chancellor: Annastasia for Primus


@annastasia_majority_chancellor
on-arrival: chancellor = "Annastasia"
go-to: ministries

Annastasia von Yoaken has become chancellor of the KCP majority.

@left_coalition
title: We can form a coalition with the unitarists?.
subtitle: KCP + UP ([+ left_coalition +]%)
view-if: left_coalition >= 50
on-arrival: leverage += 5; in_left_coalition = 1; kcp_in_government = 1; foreign_minister_party = "KCP"; culture_minister_party = "KCP" ;national_defence_minister_party = "KCP"; labor_minister_party = "UP"; finance_minister_party = "UP"; infrastructure_minister_party = "UP"; foreign_minister = "Anovium"; interior_minister = "Anovium"; labor_minister = "Moriarty"; national_defence_minister = "Evarn"; finance_minister = "Moriarty"; infrastructure_minister = "Moriarty"; culture_minister = "Primus";

We have enough votes to somehow form a coalition with the unitarists.

Who should be the Primus?

- @annastasia_coalition_chancellor

@annastasia_coalition_chancellor
title: Annastasia for Primus.
subtitle: Annastasia is a compromise candidate... with her previous anti-socialist rhetoric this may however still be a problem.
on-arrival: chancellor = "Annastasia"; chancellor_party = "KCP";
go-to: ministries

@populist_coalition
title: The Unitarists and People Front settle their diffirences?
subtitle: UP + VNPF ([+ populist_coalition +]%)
view-if: populist_coalition >= 50

Can the two parties realy form a coalition?

- @populist_success: This is ridiculous.

@populist_success
on-arrival: kcp_in_government = 0; chancellor = "Synthellic"; chancellor_party = "VNPF";

Somehow the left wing Unitarists and right wing Frontists form a coalition.


@anti_coalition
title: The anti-establishment parties somehow solve their diffirences?
subtitle: HP + UP + VNPF ([+ anti_coalition +]%)
view-if: anti_coalition >= 50

Can the anti-KCP parties realy form a coalition?

- @anti_constitutionalist_success: Hell rains down on the KCP.

@anti_constitutionalist_success
on-arrival: kcp_in_government = 0; chancellor = "Synthellic"; chancellor_party = "VNPF";

Somehow the anti-KCP forces have managed to cobble together a coalition. Only time will tell if this can last.

@national_coalition
title: National Coalition
subtitle: HP + VNPF ([+ national_coalition +]%)
view-if: national_coalition >= 50
go-to: far_right_win 
priority: 1

The VNPF finds a friend in the HP with many of their members showing support for the idea of a monarchist party even if they did it for "support of a proper opposition against the KCP" however now that the two parties have a majority their true colours have a way to show.

@far_right_win
on-arrival: chancellor = "Tbgoes"; chancellor_party = "HP"

- @hitler_takes_power: What do we do now?

@regional_coalition
title: Regionalist-Constitutionalist Coalition
subtitle: KCP + VNPF ([+ regional_coalition +]%)
view-if: moderate_plan_progress > 1 and regional_coalition >= 50
on-arrival: leverage += 5; in_regionalist_coalition = 1; kcp_in_government = 1; foreign_minister_party = "KCP"; national_defence_minister_party = "VNPF"; labor_minister_party = "VNPF"; culture_minister_party = "KCP" ;finance_minister_party = "KCP"; infrastructure_minister_party = "VNPF"; foreign_minister = "Anovium"; national_defence_minister = "Synthellic"; labor_minister = "Guineapig"; economic_minister = "Synthellic"; finance_minister = "KCP Commision"; culture_minister = "KCP Commision";infrastructure_minister = "Guineapig";

Thanks to our traditional reconstruction platform the Vynarian regionalists are open to hearing out our proposals for cooperation.

Who should be the Primus?

- @annastasia_regionalist_coalition_chancellor

@annastasia_regionalist_coalition_chancellor
title: Annastasia for Primus.
subtitle: Annastasia is a compromise candidate... with her previous anti-socialist rhetoric this may however still be a problem.
