@1932
on-arrival: {!
Q.workers = 46; // industry and trade
Q.old_middle = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 14; // "new mittelstand"
Q.rural = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 33;
Q.catholics = 30;

Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployed', 'catholics'];
Q.parties = ['kcp', 'hp', 'up', 'vnpf'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
Q.workers_kcp = 55;
Q.workers_up = 20;
Q.workers_hp = 5;
Q.workers_vnpf = 0;

Q.old_middle_kcp = 0;
Q.old_middle_up = 0;
Q.old_middle_hp = 5;
Q.old_middle_vnpf = 4;

Q.new_middle_kcp = 5;
Q.new_middle_up = 0;
Q.new_middle_hp = 5;
Q.new_middle_vnpf = 10;

Q.rural_kcp = 0;
Q.rural_up = 0;
Q.rural_hp = 65;
Q.rural_vnpf = 30;

Q.unemployed_kcp = 20;
Q.unemployed_up = 40;
Q.unemployed_hp = 0;
Q.unemployed_vnpf = 0;

Q.catholics_kcp = 10;
Q.catholics_up = 5;
Q.catholics_hl = 60;
Q.catholics_vnpf = 0;

Q.kcp_r = 25;
Q.up_r = 10;
Q.hp_r = 15;
Q.vnpf_r = 10;

!}
go-to: election_algorithm
set-jump: post_election

@post_election
on-arrival: {!
// set congress proportion to votes
Q.kcp_r = Q.kcp_votes;
Q.hp_r = Q.hp_votes;
Q.up_r = Q.up_votes;
Q.vnpf_r = Q.vnpf_votes;

// The largest party can only be the NSDAP or the SPD.
Q.largest_party = 'KCP';
if (Q.up_r >= Q.kcp_r && Q.up_r >= Q.vnpf_r) {
    Q.largest_party = 'UP';
}
if (Q.vnpf_r >= Q.kcp_r && Q.up_r >= Q.hp_r) {
    Q.largest_party = 'VNPF';
}

// coalitions
Q.left_populist_coalition = Q.up_r + Q.vnpf_r;
Q.national_front_coalition = Q.vnpf_r + Q.hp_r 
Q.anti_constitutionalist_coalition = Q.up_r + Q.hp_r + Q.vnpf_r;
Q.constitutionalist_left_coalition = Q.kcp_r + Q.up_r;
!}

The electoral system is essentially proportional, with the proportion of Reichstag seats roughly equal to the proportion of votes.
 
**Election results:**

# 1928: 30, 1930: 25, 1932: 22
KCP: [+ kcp_r +]

# 1928: 15, 1930: 15, 1932: 
HP: [+ hp_r +]

# 1928: 10, 1930: 13
UP: [+ up_r +]

# 1928: 5, 1930: 4 (as DstP)
VNPF: [+ vnpf_r +]


**Potential coalitions:**

Left-Populist Coalition (UP + VNPF): [+ left_populist_coalition +]

National Front Coalition: (HP + VNPF): [+ national_front_coalition +]

Anti-Constitutionalist Coalition (UP + HP + VNPF): [+ anti_constitutionalist_coalition+]

Constitutionalist-Left Coalition (KCP + UP): [+ constitutionalist_left_coalition +]

